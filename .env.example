# =============================================================================
# open-sky-etl-pipeline — example environment file
# Copy to `.env` and fill in real values. `.env` is gitignored (see .gitignore).
# =============================================================================

# --- NASA ---------------------------------------------------------------------
# Register a free key at https://api.nasa.gov/ — do NOT use DEMO_KEY (30 req/hr,
# 50/day is too low for the DONKI + NeoWs daily pulls). A registered key gives
# 1000 req/hour, which the whole pipeline (incl. backfill) stays well under.
NASA_API_KEY=your_registered_nasa_key_here

# --- Postgres superuser -------------------------------------------------------
# Used ONLY for the one-time role/DDL/grant bootstrap on first boot.
# No app or person ever connects with this after init.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser
POSTGRES_DB=open_sky
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Least-privilege login passwords (Section 13) -----------------------------
# One LOGIN role per app/person, each a member of a NOLOGIN group role.
DBA_APP_PASSWORD=change_me_dba
ETL_APP_PASSWORD=change_me_etl
SUPERSET_APP_PASSWORD=change_me_superset
DEV_ACHU_PASSWORD=change_me_dev

# --- Connection strings (DSNs) ------------------------------------------------
# Each authenticates as its own least-privilege login, never as POSTGRES_USER.
ETL_DSN=postgresql://etl_app:change_me_etl@postgres:5432/open_sky
SUPERSET_DSN=postgresql://superset_app:change_me_superset@postgres:5432/open_sky
DBA_DSN=postgresql://dba_app:change_me_dba@postgres:5432/open_sky

# --- Shared data volume (raw JSON + flat .psv artifacts) ----------------------
DATA_DIR=/opt/airflow/data

# --- Airflow ------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Airflow metadata DB (separate from the warehouse DB above).
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:change_me_superuser@postgres:5432/airflow

# --- Superset -----------------------------------------------------------------
SUPERSET_SECRET_KEY=change_me_generate_a_long_random_string
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
